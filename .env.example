# Aus Supabase-Projekt -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Aus Supabase-Projekt -> Project Settings -> API (NIEMALS im Frontend verwenden,
# nur serverseitig - hat vollen DB-Zugriff)
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Aus Supabase-Projekt -> Project Settings -> Database -> Connection string
# (Prisma braucht zwei Varianten: gepoolt für die App, direkt für Migrationen)
DATABASE_URL="postgresql://postgres.DEIN-PROJEKT:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.DEIN-PROJEKT:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
