// FleetOS – Datenmodell
// Multi-Tenant: fast jede Tabelle trägt companyId. Isolation wird zusätzlich
// über PostgreSQL Row-Level-Security erzwungen (siehe supabase/migrations/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Plattform-Ebene ----------

model Company {
  id        String   @id @default(uuid())
  name      String
  address   String?
  taxId     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              CompanyMember[]
  vehicles              Vehicle[]
  drivers               Driver[]
  shiftTemplates        ShiftTemplate[]
  demandProfiles        DemandProfile[]
  shifts                Shift[]
  settings              CompanySettings?

  @@map("companies")
}

enum MemberRole {
  company_owner
  dispatcher
  driver
}

// Verknüpft einen Supabase-Auth-Nutzer (auth.users.id) mit dem Unternehmen + Rolle.
model CompanyMember {
  id        String     @id @default(uuid())
  companyId String?
  userId    String // entspricht auth.users.id in Supabase
  role      MemberRole
  createdAt DateTime   @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

// Zentrale, firmenweite Planungs-Einstellungen (Nachtfenster, Ruhezeit,
// max. Abwesenheit) - ein Datensatz pro Unternehmen.
model CompanySettings {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  bundesland          String  @default("NW")
  nightStart          String  @default("22:00")
  nightEnd            String  @default("06:00")
  minRestHours        Float   @default(11)
  maxAbsenceHours     Float   @default(10)

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ---------- Fahrzeuge ----------

enum VehicleStatus {
  active
  workshop
  out_of_service
  sold
}

enum OwnershipType {
  company
  leasing
  financing
  private
}

model Vehicle {
  id             String        @id @default(uuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  licensePlate   String
  vin            String?
  brand          String?
  model          String?
  year           Int?
  color          String?
  mileage        Int           @default(0)
  status         VehicleStatus @default(active)
  ownershipType  OwnershipType @default(company)

  registrationDate    DateTime?
  concessionNumber    String?
  tuvUntil            DateTime?
  rentalPermitUntil   DateTime?
  envBadge            String?
  euroNorm            String?

  shiftTemplateId  String?
  shiftTemplate    ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  defaultDriverId  String? // abgeleitet: Fahrer mit assignment.role = stamm (App-seitig synchron gehalten)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     VehicleDriverAssignment[]
  shifts          Shift[]

  @@index([companyId])
  @@map("vehicles")
}

enum DriverRole {
  stamm
  zweit
  vertretung
  minijob
  aushilfe
  springer
}

model VehicleDriverAssignment {
  id        String     @id @default(uuid())
  vehicleId String
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  role      DriverRole
  since     DateTime   @default(now())
  note      String?

  @@index([vehicleId])
  @@index([driverId])
  @@map("vehicle_driver_assignments")
}

// ---------- Fahrer ----------

enum EmploymentType {
  fulltime
  parttime
  minijob
  shortterm
  workingStudent
  auxiliary
  freelancer
}

enum DriverStatus {
  active
  inactive
  terminated
}

model Driver {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  firstName      String
  lastName       String
  birthDate      DateTime?
  birthPlace     String?
  birthCountry   String?
  street         String?
  houseNumber    String?
  postalCode     String?
  city           String?
  country        String?
  phone          String?
  email          String?

  idNumber           String?
  idExpiry           DateTime?
  licenseNumber       String?
  licenseClass        String?
  licenseIssueDate    DateTime?
  licenseExpiry       DateTime?
  pbeScheinNumber      String?
  pbeScheinExpiry      DateTime?

  employmentType EmploymentType @default(fulltime)
  status         DriverStatus   @default(active)
  employeeNumber String?
  hireDate               DateTime?
  socialSecurityNumber   String?
  healthInsuranceProvider String?
  taxId                  String?
  qualifications String[]       @default([])

  hourlyRate             Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unavailability    DriverUnavailability[]
  highDemandWindows DriverHighDemandWindow[]
  assignments       VehicleDriverAssignment[]
  shifts            Shift[] @relation("ShiftDriver")
  substituteShifts  Shift[] @relation("ShiftPrimaryDriver")

  @@index([companyId])
  @@map("drivers")
}

model DriverUnavailability {
  id       String   @id @default(uuid())
  driverId String
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type     String // vacation | sick | other
  start    DateTime
  end      DateTime
  note     String?

  @@index([driverId])
  @@map("driver_unavailability")
}

// Bevorzugte, wöchentlich wiederkehrende Hochnachfrage-Zeitfenster pro Fahrer
model DriverHighDemandWindow {
  id        String @id @default(uuid())
  driverId  String
  driver    Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  label     String?
  startDow  Int // 0 = Sonntag .. 6 = Samstag
  startTime String // "HH:MM"
  endDow    Int
  endTime   String

  @@index([driverId])
  @@map("driver_high_demand_windows")
}

// ---------- Schichtmodelle & Nachfrageprofile ----------

enum ShiftTemplateMode {
  fixed
  flexible
}

model ShiftTemplate {
  id              String            @id @default(uuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  active          Boolean           @default(true)
  isDefault       Boolean           @default(false)
  mode            ShiftTemplateMode @default(fixed)
  singleDriverMode Boolean          @default(false)
  holidaysEnabled Boolean           @default(false)
  createdAt       DateTime          @default(now())

  shifts        ShiftTemplateShift[] @relation("TemplateShifts")
  holidayShifts ShiftTemplateShift[] @relation("HolidayShifts")
  vehicles      Vehicle[]

  @@index([companyId])
  @@map("shift_templates")
}

model ShiftTemplateShift {
  id                     String         @id @default(uuid())
  shiftTemplateId        String
  shiftTemplate          ShiftTemplate  @relation("TemplateShifts", fields: [shiftTemplateId], references: [id], onDelete: Cascade)
  holidayForTemplateId   String?
  holidayForTemplate     ShiftTemplate? @relation("HolidayShifts", fields: [holidayForTemplateId], references: [id])

  name                   String
  description            String?
  driverCount            Int      @default(1)
  weekdays               Int[]    @default([0, 1, 2, 3, 4, 5, 6]) // 0=So..6=Sa
  requiredQualification  String?

  earliestStart          String // "HH:MM"
  latestStart            String
  targetNetHours         Float
  maxShiftHours          Float

  flexibleStart          Boolean @default(true)
  prioritizeDemand       Boolean @default(false)
  optimizeNightSurcharge Boolean @default(false)
  autoBreak              Boolean @default(true)

  @@index([shiftTemplateId])
  @@map("shift_template_shifts")
}

enum DemandLevel {
  niedrig
  mittel
  hoch
  sehr_hoch
}

model DemandProfile {
  id        String      @id @default(uuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  weekday   Int // 0=So..6=Sa
  startTime String // "HH:MM"
  endTime   String // "HH:MM", darf über Mitternacht hinausgehen (z. B. Fr 16:00 -> Sa 03:00 als endTime "03:00" mit Flag im App-Code)
  level     DemandLevel

  @@index([companyId, weekday])
  @@map("demand_profiles")
}

// ---------- Dienstplan ----------

model Shift {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId  String?
  driver    Driver?  @relation("ShiftDriver", fields: [driverId], references: [id])

  date            DateTime
  start           String // "HH:MM"
  end             String // "HH:MM"
  breakMinutes    Int      @default(0)
  commuteMinutes  Int      @default(0)

  generated           Boolean @default(false)
  isSubstitute         Boolean @default(false)
  primaryDriverId      String?
  primaryDriver        Driver? @relation("ShiftPrimaryDriver", fields: [primaryDriverId], references: [id])
  fromShiftTemplateId  String?
  shiftName            String?
  isHoliday            Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breaks ShiftBreak[]

  @@index([companyId, date])
  @@index([vehicleId, date])
  @@index([driverId, date])
  @@map("shifts")
}

// Einzelne Pausenblöcke einer Schicht (Minuten seit Schichtbeginn), damit
// Aufteilungen wie 15+15 statt nur einer Gesamtminutenzahl abgebildet werden.
model ShiftBreak {
  id      String @id @default(uuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  start   Int // Minuten seit Schichtbeginn
  end     Int

  @@index([shiftId])
  @@map("shift_breaks")
}

// ---------- Vergütung ----------
// Fahrer haben einen optionalen Stundenlohn (Driver.hourlyRate) für die
// Lohn-Zusammenfassung im Dienstplan-Excel. Weitere Vergütungs-/Umsatz-/
// Wartungsmodelle wurden entfernt - stdplan ist ausschließlich das
// Werkzeug zum Erstellen des Dienstplans.
